<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mai_multiinvoice_payment.PaymentEmbeddedListController" t-inherit="web.ListView" t-inherit-mode="primary">
        <t t-set-slot="control-panel-additional-actions" position="replace"/>
    </t>

    <t t-name="mai_multiinvoice_payment.PaymentEmbeddedListWidget">
        <div class="mai_payment_embedded_list_widget o_field_widget">
            <t t-if="canShowEmbeddedList">
                <PaymentEmbeddedViewEmbedder viewProps="viewProps" embedKey="embedKey"/>
            </t>
            <div t-else="" class="alert alert-info mb-0" role="status">
                Save this payment as draft, then select partner and currency to load lines with search.
            </div>
        </div>
    </t>

</templates>
