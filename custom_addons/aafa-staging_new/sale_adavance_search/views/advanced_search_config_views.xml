<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_search_config_list" model="ir.ui.view">
        <field name="name">advanced.search.config.list</field>
        <field name="model">advanced.search.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id"/>
                <field name="model_name" optional="hide"/>
                <field name="field_ids" widget="many2many_tags"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_advanced_search_config_form" model="ir.ui.view">
        <field name="name">advanced.search.config.form</field>
        <field name="model">advanced.search.config</field>
        <field name="arch" type="xml">
            <form string="Advanced Search">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="model_id"/>
                        <h1>
                            <field name="model_id" placeholder="Select a model"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Users can type comma-separated values in the search bar for the fields below
                        (example: <code>SO001,SO002,SO003</code>). Reload the browser after saving
                        for the change to apply.
                    </div>
                    <notebook>
                        <page string="Search Fields" name="fields">
                            <field name="field_ids" nolabel="1"
                                   context="{'default_model_id': model_id}"
                                   options="{'no_create': True, 'no_open': True}">
                                <list create="false">
                                    <field name="name"/>
                                    <field name="field_description"/>
                                    <field name="ttype"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_advanced_search_config_search" model="ir.ui.view">
        <field name="name">advanced.search.config.search</field>
        <field name="model">advanced.search.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="field_ids"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_advanced_search_config" model="ir.actions.act_window">
        <field name="name">Advanced Search</field>
        <field name="res_model">advanced.search.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure comma-separated search</p>
            <p>
                Add a model, then pick the search-bar fields that should accept
                multiple values separated by commas.
            </p>
        </field>
    </record>

    <menuitem id="menu_advanced_search_config"
              name="Advanced Search"
              parent="base.next_id_2"
              action="action_advanced_search_config"
              sequence="8"/>

    <function model="advanced.search.config" name="_install_defaults"/>
</odoo>
