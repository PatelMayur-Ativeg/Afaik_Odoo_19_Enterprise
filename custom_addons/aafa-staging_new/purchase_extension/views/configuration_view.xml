<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_purchase_category_form" model="ir.ui.view">
        <field name="name">view.purchase.category.form</field>
        <field name="model">purchase.category</field>
        <field name="arch" type="xml">
        	<list string="Purchase Category" editable="bottom">
        		<field name="name"/>
        	</list>
        </field>
    </record>

	<record id="purchase_category_action_form" model="ir.actions.act_window">
        <field name="name">Purchase Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.category</field>
        <field name="view_mode">list</field>
        <!-- <field name="view_id" ref="purchase.purchase_order_kpis_tree"/> -->
        <field name="domain">[]</field>
        <!-- <field name="search_view_id" ref="purchase.view_purchase_order_filter"/> -->
        <!-- <field name="context">{'default_is_purchase_requisition': True}</field> -->
    </record>

    <menuitem 
    	action="purchase_category_action_form" 
    	id="menu_purchase_category_config" 
    	parent="purchase.menu_product_in_config_purchase" 
    	sequence="4"
    />


</odoo>
