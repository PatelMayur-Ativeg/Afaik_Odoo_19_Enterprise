<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aafaq_import_log_tree" model="ir.ui.view">
        <field name="name">aafaq.import.log.tree</field>
        <field name="model">aafaq.import.log</field>
        <field name="arch" type="xml">
            <list string="Import Logs" default_order="id desc">
                <field name="processed_at"/>
                <field name="import_source" optional="show"/>
                <field name="alias_email" optional="show"/>
                <field name="alias_config_id" optional="hide"/>
                <field name="email_from" optional="hide"/>
                <field name="level"/>
                <field name="error_type"/>
                <field name="queue_id"/>
                <field name="record_key"/>
                <field name="row_number"/>
                <field name="model"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_aafaq_import_log_search" model="ir.ui.view">
        <field name="name">aafaq.import.log.search</field>
        <field name="model">aafaq.import.log</field>
        <field name="arch" type="xml">
            <search string="Search Import Logs">
                <field name="message" string="Message"/>
                <field name="record_key"/>
                <field name="model"/>
                <field name="queue_id"/>
                <field name="alias_email"/>
                <field name="email_from"/>

                <filter name="filter_info" string="Info" domain="[('level', '=', 'info')]"/>
                <filter name="filter_warning" string="Warnings" domain="[('level', '=', 'warning')]"/>
                <filter name="filter_error" string="Errors" domain="[('level', '=', 'error')]"/>

                <separator/>
                <filter name="filter_email" string="Incoming Email" domain="[('import_source', '=', 'email')]"/>
                <filter name="filter_manual" string="Internal Upload" domain="[('import_source', '=', 'manual')]"/>

                <separator/>

                <filter name="filter_validation" string="Validation Errors" domain="[('error_type', '=', 'validation')]"/>
                <filter name="filter_user" string="User Errors" domain="[('error_type', '=', 'user')]"/>
                <filter name="filter_access" string="Access Errors" domain="[('error_type', '=', 'access')]"/>
                <filter name="filter_missing" string="Missing Records" domain="[('error_type', '=', 'missing')]"/>
                <filter name="filter_system" string="System Errors" domain="[('error_type', '=', 'system')]"/>

                <separator/>

                <filter name="group_by_queue" string="Queue" context="{'group_by': 'queue_id'}"/>
                <filter name="group_by_alias" string="Email Alias" context="{'group_by': 'alias_config_id'}"/>
                <filter name="group_by_source" string="Source" context="{'group_by': 'import_source'}"/>
                <filter name="group_by_level" string="Level" context="{'group_by': 'level'}"/>
                <filter name="group_by_error_type" string="Error Type" context="{'group_by': 'error_type'}"/>
                <filter name="group_by_model" string="Model" context="{'group_by': 'model'}"/>
                <filter name="group_by_date" string="Processed Date" context="{'group_by': 'processed_at:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_aafaq_import_log" model="ir.actions.act_window">
        <field name="name">Import Logs</field>
        <field name="res_model">aafaq.import.log</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_filter_error': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No import logs yet</p>
            <p>Errors from internal uploads and incoming emails appear here, including the email alias when the file came by mail.</p>
        </field>
    </record>
