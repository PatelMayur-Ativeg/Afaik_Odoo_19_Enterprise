<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_prodict_mapping_tree" model="ir.ui.view">
        <field name="name">product.mapping.list</field>
        <field name="model">product.mapping</field>
        <field name="arch" type="xml">
            <list string="Analytic Account Mapping" open_form_view="True" editable="top" multi_edit="1" default_order="sequence, id desc">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <field name="analytic_account_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>

    <record id="view_product_mapping_form" model="ir.ui.view">
        <field name="name">product.mapping.form</field>
        <field name="model">product.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="analytic_account_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_mappping_classification" model="ir.actions.act_window">
        <field name="name">Product Mapping</field>
        <field name="res_model">product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_mapping"
              name="Product Mapping"
              parent="contacts.res_partner_menu_config"
              action="action_product_mappping_classification"
              sequence="30"/>
</odoo>
