<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_account_mapping_tree" model="ir.ui.view">
        <field name="name">currency.account.mapping.list</field>
        <field name="model">currency.account.mapping</field>
        <field name="arch" type="xml">
            <list string="Wakala Currency COA Map" open_form_view="True" editable="top" multi_edit="1" default_order="sequence, id desc">
                <field name="sequence" widget="handle"/>
                <field name="currency_id" />
                <field name="customer_type" />
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="view_account_mapping_form" model="ir.ui.view">
        <field name="name">currency.account.mapping.form</field>
        <field name="model">currency.account.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="currency_id" />
                        <field name="customer_type" />
                        <field name="account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_currency_account_mapping" model="ir.actions.act_window">
        <field name="name">Wakala Currency COA Map</field>
        <field name="res_model">currency.account.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_mapping"
              name="Wakala Currency COA Map"
              parent="contacts.res_partner_menu_config"
              action="action_currency_account_mapping"
              sequence="30"/>
</odoo>