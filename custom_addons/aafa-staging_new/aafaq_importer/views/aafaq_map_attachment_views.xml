<odoo>
    <!-- Action to open the list view -->
    <record id="action_aafaq_map_attachment" model="ir.actions.act_window">
        <field name="name">Aafaq Attachments</field>
        <field name="res_model">aafaq.map.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Aafaq Attachments found.
            </p>
            <p>
                Create a new Aafaq attachment to link documents with Aafaq internal IDs.
            </p>
        </field>
    </record>

    <!-- Menu item under some parent (replace parent.menu_id with your menu) -->
    <menuitem id="menu_aafaq_map_attachment_root"
              name="Aafaq Attachments"
              parent="menu_aafaq_import_root"
              action="action_aafaq_map_attachment"
              sequence="100"/>

    <!-- list/List view -->
    <record id="view_aafaq_map_attachment_list" model="ir.ui.view">
        <field name="name">aafaq.map.attachment.list</field>
        <field name="model">aafaq.map.attachment</field>
        <field name="arch" type="xml">
            <list string="Aafaq Attachments" default_order="id desc">
                <field name="internal_id"/>
                <field name="attachment_id"/>
                <field name="company_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_aafaq_map_attachment_form" model="ir.ui.view">
        <field name="name">aafaq.map.attachment.form</field>
        <field name="model">aafaq.map.attachment</field>
        <field name="arch" type="xml">
            <form string="Aafaq Attachment">
                <sheet>
                    <group>
                        <field name="internal_id"/>
                        <field name="attachment_id"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
