<?xml version="1.0" ?>
<odoo>

    <record id="view_asset_location_form" model="ir.ui.view">
        <field name="name">asset.location.form</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <form string="Asset Location">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_asset_tracking"
                            class="oe_stat_button"
                            icon="fa-television"
                            string="Assets"
                        >
                            <field
                                name="asset_count"
                                widget="statinfo"
                                string="Assets"
                            />
                        </button>
                    </div>
        
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="asset_code"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="warehouse_bool"/>
                            <field name="scrap_bool"/>
                        </group>
                    </group>
                    
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

	<record id="view_asset_location_tree" model="ir.ui.view">
        <field name="name">asset.location</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <list string="Asset Location">
                <field name="name"/>
                <field name="company_id"/>
                <field name="asset_code"/>
                <field name="warehouse_bool"/>
                <field name="scrap_bool"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="asset_location_form_action">
        <field name="name">Asset Location</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">asset.location</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create new asset location.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_asset_location"
        name="Asset Location"
        parent="asset_tracking.parent_menu_asset_tracking"
        action="asset_location_form_action"
        sequence="30"
    />
</odoo>