    <record id="sh_expenses_order_my_approval_action" model="ir.actions.act_window">
        <field name="name">My Approval</field>
        <field name="res_model">hr.expense</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="view_id" ref="hr_expense.view_my_expenses_tree" />
        <field name="domain">[('is_boolean','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>

