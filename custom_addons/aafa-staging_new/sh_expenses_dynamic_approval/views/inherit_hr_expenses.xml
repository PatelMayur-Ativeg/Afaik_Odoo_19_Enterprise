<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <record id="view_hr_expense_form_inherit1" model="ir.ui.view">
        <field name="name">hr.expense.inherit1.view.form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>


    <record id="view_hr_expense_sheet_form_inherit" model="ir.ui.view">
        <field name="name">hr.expense.inherit.view.form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="approval_level_id" invisible="1" readonly="1"/>
                <field name="is_boolean"  invisible="1"/>
                <field name="manager_approval" invisible="1"/>
                <field name="request_approve" invisible="1" readonly="1"/>
            </field>

            <xpath expr="//field[@name='payment_mode']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <!-- <field name="hide_admin_fields" invisible="1"/> -->
                <button string="Reject" type="action" name="%(sh_expenses_dynamic_approval.sh_expenses_rejection_reason_action)d" 
                    invisible="not is_boolean" />
                    <!-- attrs="{'invisible':['|',('state','not in',['waiting_for_approval']),('is_boolean','=',False)]}" /> -->
                <!-- <button string="Reset to Draft" type="object" name="action_reset_to_draft" attrs="{'invisible':[('state','not in',['reject'])]}" /> -->
            </xpath>
            <xpath expr="//header/field[@name='state']" position="replace">
                <field
                    name="state"
                    widget="statusbar"
                    statusbar_visible="draft,waiting_for_review,submit,approve,post,done,cancel"
                    />
            </xpath>
            <!-- <xpath expr="//header/button[@name='approve_expense_sheets']" position="replace">
                <button name="approve_expense_sheets"
                    string="Approve"
                    type="object"
                    data-hotkey="v"
                    context="{'validate_analytic': True}"
                    class="oe_highlight o_expense_sheet_approve"
                    invisible="not can_approve or state not in ['submit'] or not is_boolean"

                    />
                />
            </xpath> -->

            <xpath expr="//header/button[@name='action_submit']" position="after">
                <button
                    name="button_to_approve"
                    string="Request approval"
                    type="object"
                    class="oe_highlight" invisible="state not in ['waiting_for_review'] or ('manager_approval','!=',True) "
                />
            </xpath>

            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Approval Info" name="approval_info">
                        <group>

                            <group string="Next Approval">
                                <field name="level" />
                                <field name="user_ids" widget="many2many_tags" readonly="1" force_save="1" />
                                <field name="group_ids" widget="many2many_tags" />
                            </group>

                            <group string="Reject Order Info">
                                <field name="rejection_date" />
                                <field name="reject_by" />
                                <field name="reject_reason" />
                            </group>

                            <field name="approval_info_line" nolabel="1" context="{'form_view_ref': 'sh_expenses_dynamic_approval.sh_approval_info_view_form'}">
                                <list>
                                    <field name="label_type"/>
                                    <field name="level" />
                                    <field name="user_ids" />
                                    <field name="group_ids" />
                                    <field name="status" widget="boolean_toggle" readonly="1" />
                                    <field name="approval_date" />
                                    <field name="approved_by" />
                                    <field name="hr_expenses_id" invisible="1" />
                                </list>
                            </field>
                        </group>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>

