<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="terms_and_conditions_view_form" model="ir.ui.view">
        <field name="name">terms.and.conditions.form</field>
        <field name="model">terms.and.conditions</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" default_focus="1" placeholder="Name" />
                        </h1>
                    </div>
                     <notebook>
                        <page string="Terms And Condtions">
                            <field name="terms" nolabel="1" widget="html" />
                        </page>
                     </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="terms_and_conditions_view_tree" model="ir.ui.view">
        <field name="name">terms.and.conditions.view.list</field>
        <field name="model">terms.and.conditions</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="terms_and_conditions_action" model="ir.actions.act_window">
        <field name="name">Terms And Conditions</field>
        <field name="res_model">terms.and.conditions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create A New Terms and Conditions</p>
        </field>
    </record>

    <menuitem   id="terms_and_conditions_action_menu"
                name="Terms And Conditions"
                action="terms_and_conditions_action"
                parent="purchase.menu_purchase_config"
                sequence="99" />
</odoo>