<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sh_purchase_approval_line_form" model="ir.ui.view">
        <field name="name">sh.purchase.approval.line</field>
        <field name="model">sh.purchase.approval.line</field>
        <field name="arch" type="xml">
            <form string="Create Approval Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="label_type"/>
                            <field name="approve_by" />
                            <field name="level" />
                            <field name="is_boolean" invisible="1" />
                            <field name="purchase_approval_config_id" invisible="1" />
                        </group>
                        <group>
                            <field name="is_admin_approval" />
                            <field name="create_rfq_access"></field>
                            <field name="show_in_report"></field>
                        </group>
                    </group>

                    <field name="user_ids" invisible="is_boolean" nolabel="1" />
                    <field name="group_ids" invisible="not is_boolean" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

</odoo>