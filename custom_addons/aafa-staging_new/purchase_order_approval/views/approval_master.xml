<odoo>
     <record id="approval_tree" model="ir.ui.view">
        <field name="name">approval.details.list</field>
        <field name="model">approval.master</field>
        <field name="arch" type="xml">
                <list string="Approve">
                    <field name="user_ids"/>
                    <field name="min_amount"/>
                    <field name="mx_amount"/>
                </list>
        </field>
    </record>

    <record id="approval_form" model="ir.ui.view">
        <field name="name">approval.details.form</field>
        <field name="model">approval.master</field>
        <field name="arch" type="xml">
                <form string="Approve">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <!-- <field name="user_ids" required="True"/> -->
                                <!-- <field name="analytic_account_id" required="True"/> -->
                            </group>
                            <group>
                                 <field name="min_amount"/>
                                <field name="mx_amount"/>
                            </group>
                        </group>
                        <button name="add_level" type="object" string="Add a Level of Approval" class="btn btn-primary"/>
                        <button name="remove_level" type="object" string="Remove last Level of Approval" class="oe_right btn btn-primary"/>
                        <notebook>
                            <page string="Approval Details" name="approval lines">
                                <field name="user_ids">
                                    <list string="Approve Order Lines" editable="bottom" create="0" delete="0">
                                            <field name="approval_level" readonly="1"/>
                                            <field name="approval_user_id" widget="many2many_tags" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
        </field>
    </record>

    <record id="approval_action_purchase" model="ir.actions.act_window">
        <field name="name">Approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">approval.master</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new approval details!
            </p>
        </field>
    </record>

    <menuitem id="approval_details_root"
              name="Approvals"
              action="approval_action_purchase"
              parent="purchase.menu_purchase_config"
              sequence="7"/>
</odoo>