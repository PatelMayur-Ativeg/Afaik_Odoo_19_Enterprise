<odoo>
    <record id="account_order_inherit_view_form" model="ir.ui.view">
        <field name="name">account.move.inherit.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field name="account_approval_type" required="1"/>
                <field name="approval_level_id" options="{'no_open':True,'no_create':1,'no_create_edit':1}" required="1" domain="[('approval_type','=',account_approval_type)]"/>
                <field name="is_boolean" invisible="1"/>
            </field>

            <xpath expr="//header" position="inside">
                <button class="oe_highlight" string="Approve" type="object" name="action_approve_order" invisible="state not in ['waiting_for_approval'] or not is_boolean" />
                <button string="Reject" type="action" name="%(account_dynamic_approval.account_rejection_reason_action)d" invisible="state not in ['waiting_for_approval'] or not is_boolean"/>
                <button string="Reset to Draft" type="object" name="action_reset_to_draft" invisible="state not in ['reject']" />

            </xpath>

            <xpath expr="//notebook//page[@name='other_info']" position="after">
                <page string="Approval Info" name="">
                    <group>

                        <group string="Next Approval">
                            <field name="level" />
                            <field name="user_ids" widget="many2many_tags" />
                            <field name="group_ids" widget="many2many_tags" />
                        </group>

                        <group string="Reject Order Info">
                            <field name="rejection_date" />
                            <field name="reject_by" />
                            <field name="reject_reason" />
                        </group>

                        <field name="approval_info_line" nolabel="1" context="{'form_view_ref': 'account_dynamic_approval.account_approval_info_view_form'}">
                            <list>
                                <field name="level" />
                                <field name="user_ids" />
                                <field name="group_ids" />
                                <field name="status" widget="boolean_toggle" readonly="1" />
                                <field name="approval_date" />
                                <field name="approved_by" />
                                <field name="move_id" invisible="1" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="sh_account_waiting_approval_action" model="ir.actions.act_window">
        <field name="name">Waiting Approval</field>
        <field name="res_model">account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree" />
        <field name="domain">[('state','=','waiting_for_approval')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>

    <menuitem   id="sh_account_waiting_approval_action_menu"
                name="Waiting Approval"
                action="sh_account_waiting_approval_action"
                parent="account.menu_finance_receivables"
                sequence="1" />

    <record id="sh_account_my_approval_action" model="ir.actions.act_window">
        <field name="name">My Approval</field>
        <field name="res_model">account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree" />
        <field name="domain">[('is_boolean','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>

    <menuitem   id="sh_account_my_approval_action_menu"
                name="My Approval"
                action="sh_account_my_approval_action"
                parent="account.menu_finance_receivables"
                sequence="1" />
</odoo>