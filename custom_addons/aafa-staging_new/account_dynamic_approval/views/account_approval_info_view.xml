<odoo>
	<record id="account_approval_info_view_form" model="ir.ui.view">
		<field name="name">account.approval.info.view.form</field>
		<field name="model">account.approval.info</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="level"/>
							<field name="status" widget="boolean_toggle"/>
						</group>
						<group>
							<field name="approval_date"/>
							<field name="approved_by"/>
							<field name="move_id" invisible="1"/>
						</group>
					</group>
					<field name="user_ids"/>
					<field name="group_ids"/>
				</sheet>
			</form>
		</field>
	</record>


	<record id="payment_approval_info_view_form" model="ir.ui.view">
		<field name="name">payment.approval.info.view.form</field>
		<field name="model">payment.approval.info</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="level"/>
							<field name="status" widget="boolean_toggle"/>
						</group>
						<group>
							<field name="approval_date"/>
							<field name="approved_by"/>
							<field name="payment_id" invisible="1"/>
						</group>
					</group>
					<field name="user_ids"/>
					<field name="group_ids"/>
				</sheet>
			</form>
		</field>
	</record>

    <record id="batch_payment_approval_info_view_form" model="ir.ui.view">
		<field name="name">batch.payment.approval.info.view.form</field>
		<field name="model">batch.payment.approval.info</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="level"/>
							<field name="status" widget="boolean_toggle"/>
						</group>
						<group>
							<field name="approval_date"/>
							<field name="approved_by"/>
							<field name="batch_payment_approval_id" invisible="1"/>
						</group>
					</group>
					<field name="user_ids"/>
					<field name="group_ids"/>
				</sheet>
			</form>
		</field>
	</record>
</odoo>