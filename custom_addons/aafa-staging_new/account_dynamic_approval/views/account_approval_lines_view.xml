<odoo>
	<record id="sh_account_approval_line_form" model="ir.ui.view">
		<field name="name">sh.account.approval.line</field>
		<field name="model">sh.account.approval.line</field>
		<field name="arch" type="xml">
			<form string="Create Approval Configuration">
				<sheet>
					<group>
						<group>
							<field name="approve_by" />
							<field name="level" />
							<field name="is_boolean" invisible="1" />
							<field name="account_approval_config_id" invisible="1" />
						</group>
						<group>
							<field name="from_amount" invisible="1" />
							<field name="to_amount" invisible="1" />
						</group>
					</group>
					<field name="user_ids" invisible="is_boolean" nolabel="1"/>
					<field name="group_ids" invisible="not is_boolean" nolabel="1" />
				</sheet>
			</form>
		</field>
	</record>
	<record id="sh_payment_approval_line_form" model="ir.ui.view">
		<field name="name">sh.payment.approval.line</field>
		<field name="model">sh.payment.approval.line</field>
		<field name="arch" type="xml">
			<form string="Create Approval Configuration">
				<sheet>
					<group>
						<group>
							<field name="label_type"/>
							<field name="approve_by"/>
							<field name="level"/>
							<field name="is_boolean" invisible="1"/>
							<field name="payment_approval_config_id" invisible="1"/>
						</group>
						<group>
							<field name="from_amount" invisible="1"/>
							<field name="to_amount" invisible="1"/>
						</group>
					</group>
					<field name="user_ids" invisible="is_boolean" nolabel="1"/>
					<field name="group_ids" invisible="not is_boolean" nolabel="1"/>
				</sheet>
			</form>
		</field>
	</record>
    <record id="sh_batch_payment_approval_line_form" model="ir.ui.view">
		<field name="name">sh.batch.payment.approval.line</field>
		<field name="model">sh.batch.payment.approval.line</field>
		<field name="arch" type="xml">
			<form string="Create Approval Configuration">
				<sheet>
					<group>
						<group>
							<field name="label_type"/>
							<field name="approve_by"/>
							<field name="level"/>
							<field name="is_boolean" invisible="1"/>
							<field name="batch_payment_approval_config_id" invisible="1"/>
						</group>
						<group>
							<field name="from_amount" invisible="1"/>
							<field name="to_amount" invisible="1"/>
						</group>
					</group>
					<field name="user_ids" invisible="is_boolean" nolabel="1"/>
					<field name="group_ids" invisible="not is_boolean" nolabel="1"/>
				</sheet>
			</form>
		</field>
	</record>
</odoo>