<odoo>

    <record model="ir.actions.server" id="action_account_create_batch_payment_approval">
            <field name="name">Create batch payment approval</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = records.create_batch_payment_approval()
            </field>
        </record>

    <record id="view_batch_payment_approval_form" model="ir.ui.view">
        <field name="name">batch.payment.approval.form</field>
        <field name="model">batch.payment.approval</field>
        <field name="arch" type="xml">
            <form string="Batch Payment Approval">
            <header>
                <field name="id" invisible="1"/>
                <button name="action_post" class="oe_highlight" string="Approve" type="object" invisible="state != 'waiting_for_approval' or not payment_ids or not is_boolean"/>
                <button name="action_request_approval" class="oe_highlight" string="Request Approval" type="object" invisible="state != 'draft' or not payment_ids"/>
                <!-- <button name="validate_batch_button" class="oe_highlight" string="Validate" type="object" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('payment_ids', '=', [])]}"/> -->
                <button string="Reject" type="action" name="%(account_dynamic_approval.batch_payment_rejection_reason_action)d" invisible="state not in ['waiting_for_approval'] or not is_boolean"/>
				<button string="Reset to Draft" type="object" name="action_reset_to_draft" invisible="state not in ['reject']"/>
                <field name="state" widget="statusbar"/>
                <field name="approval_level_id" invisible="1"/>
				<field name="is_boolean" invisible="1"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <label for="name"/>
                    <h1>
                        <field name="name" readonly="state not in ['draft']"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="date"/>
                        <!-- <field name="name" placeholder="Leave empty to generate automatically..." required="0"/> -->
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                    </group>
                </group>

                <notebook>
                    <page string="Batch Content" name="batch_content">
                        <field name="payment_ids"
                                readonly="state not in ['draft']"
                                force_save="1"
                                widget="many2many"
                                domain="[('state', '=', 'draft'), ('payment_type','=','outbound')]"
                                options="{'no_create': True}">
                            <list string="Payments" decoration-muted="state == 'draft'" create="false">
                                <field name="name"/>
                                <field name="date"/>
                                <field name="partner_id"/>
                                <field name="payment_reference"/>
                                <field name="amount_signed" sum="Total" string="Amount"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="state" invisible="1"/>
                                <field name="payment_method_id" invisible="1"/>
                            </list>
                        </field>
                    </page>
					<page string="Approval Info" name="" invisible="state in ['posted','cancel']">
						<group>
							<group string="Next Approval">
								<field name="level"/>
								<field name="user_ids" widget="many2many_tags"/>
								<field name="group_ids" widget="many2many_tags"/>
							</group>
							<group string="Reject Order Info">
								<field name="rejection_date"/>
								<field name="reject_by"/>
								<field name="reject_reason"/>
							</group>
							<field name="approval_info_line" nolabel="1" context="{'form_view_ref': 'account_dynamic_approval.batch_payment_approval_info_view_form'}">
								<list>
									<field name="label_type"/>
									<field name="level"/>
									<field name="user_ids"/>
									<field name="group_ids"/>
									<field name="status" widget="boolean_toggle" readonly="1"/>
									<field name="approval_date"/>
									<field name="approved_by"/>
									<field name="batch_payment_approval_id" invisible="1"/>
								</list>
							</field>
						</group>
					</page>
                </notebook>
            </sheet>
            <chatter/>
            </form>
        </field>
    </record>


    <record id="view_batch_payment_approval_search" model="ir.ui.view">
        <field name="name">batch.payment.approval.search</field>
        <field name="model">batch.payment.approval</field>
        <field name="arch" type="xml">
            <search string="Batch Payment Approval">

                <!-- Search Fields -->
                <field name="name"/>
                <field name="state"/>

                <!-- Filters -->
                <filter string="Draft" name="filter_draft"
                        domain="[('state','=','draft')]"/>

                <filter string="Waiting For Approval" name="filter_waiting"
                        domain="[('state','=','waiting_for_approval')]"/>

                <!-- Group By -->
                <filter string="State" name="group_by_state"
                        context="{'group_by': 'state'}"/>

            </search>
        </field>
    </record>

    <record id="view_batch_payment_approval_tree" model="ir.ui.view">
        <field name="name">batch.payment.approval.list</field>
        <field name="model">batch.payment.approval</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'posted'" decoration-info="state == 'draft'" sample="1">
                <field name="name"/>
                <field name="date"/>
                <!-- <field name="amount"/> -->
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>



    <record id="action_batch_payment_approval" model="ir.actions.act_window">
        <field name="name">Batch Payments Approval</field>
        <field name="res_model">batch.payment.approval</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_batch_payment_approval_tree"/>
        <field name="search_view_id" ref="view_batch_payment_approval_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new batch payment approvals
            </p><p>
                Batch payments Approval allows you grouping different payments to ease
               approvals.
            </p>
        </field>
    </record>

    <menuitem action="action_batch_payment_approval" name="Batch Payment Approval" id="menu_batch_payment_approval" parent="account.menu_finance_payables" sequence="20" groups="account.group_account_readonly"/>


</odoo>
