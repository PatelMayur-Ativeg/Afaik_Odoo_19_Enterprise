<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="budget_approval_config_view_form" model="ir.ui.view">
        <field name="name">budget.approval.config.view.form</field>
        <field name="model">budget.approval.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" default_focus="1" placeholder="Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_ids" widget="many2many_tags" options="{'no_open':True,'no_create':1,'no_create_edit':1}" groups="base.group_multi_company
                            " />
                            <field name="is_boolean" widget="boolean_toggle" invisible="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Approval Details" name="budget_approvals_details">
                            <field name="budget_approval_line" nolabel="1" context="{'form_view_ref': 'custom_aafa.budget_approval_line_form'}">
                                <list>
                                    <field name="label_type"/>
                                    <field name="is_send_email" widget="boolean_toggle"/>
                                    <field name="level"  width="10%"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="budget_approval_config_view_list" model="ir.ui.view">
        <field name="name">budget.approval.config.view.list</field>
        <field name="model">budget.approval.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Approval Configuration" />
                <field name="is_boolean" widget="boolean_toggle" invisible="1"/>
            </list>
        </field>
    </record>
  

    <record id="budget_approval_config_action" model="ir.actions.act_window">
        <field name="name">Budget Approval Configuration</field>
        <field name="res_model">budget.approval.config</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create A New Approval Configuration</p>
        </field>
    </record>
    <menuitem   id="budget_approval_config_action_menu"
                name="Budget Approval Configuration" 
                action="budget_approval_config_action"  
                parent="account.account_account_menu"
                sequence="1" />
</odoo>