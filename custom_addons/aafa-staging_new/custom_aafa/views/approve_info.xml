<odoo>

    <record id="budget_approval_info_view_form" model="ir.ui.view">
        <field name="name">budget.approval.info.view.form</field>
        <field name="model">budget.approval.info</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="level"/>
                            <field name="label_type"/>
                            <field name="status" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field name="approval_date" />
                            <field name="approved_by" />
                            <field name="cross_budget_id" invisible="1" />
                        </group>
                    </group>
                    <field name="user_ids" nolabel="1"/>
                    <!-- <field name="group_ids" /> -->
                </sheet>
            </form>
        </field>
    </record>

</odoo>