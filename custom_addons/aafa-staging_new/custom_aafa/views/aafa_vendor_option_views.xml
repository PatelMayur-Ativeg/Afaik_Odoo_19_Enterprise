<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aafa_vendor_option_list" model="ir.ui.view">
        <field name="name">aafa.vendor.option.list</field>
        <field name="model">aafa.vendor.option</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="option_type, sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="option_type"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_aafa_vendor_option_form" model="ir.ui.view">
        <field name="name">aafa.vendor.option.form</field>
        <field name="model">aafa.vendor.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="option_type"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aafa_vendor_option_search" model="ir.ui.view">
        <field name="name">aafa.vendor.option.search</field>
        <field name="model">aafa.vendor.option</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="option_type"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Field" name="group_option_type" context="{'group_by': 'option_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_aafa_vendor_option" model="ir.actions.act_window">
        <field name="name">Vendor Options</field>
        <field name="res_model">aafa.vendor.option</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_option_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a vendor option</p>
            <p>Options are grouped by field. Add values under Vendor Category, Vendor Status, and the other vendor selection fields.</p>
        </field>
    </record>

    <menuitem
        id="menu_aafa_vendor_option"
        name="Vendor Options"
        parent="contacts.res_partner_menu_config"
        action="action_aafa_vendor_option"
        sequence="50"/>
</odoo>
