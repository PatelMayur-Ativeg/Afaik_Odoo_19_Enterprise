<odoo>
    <record id="view_batch_payment_form_inherit_aafa" model="ir.ui.view">
        <field name="name">account.batch.payment.form.inherit.aafa</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="payment_mode" readonly="state != 'draft'"/>
                <field name="memo" placeholder="General purpose or notes for the batch" readonly="state != 'draft'"/>
            </field>
            <xpath expr="//field[@name='payment_ids']//field[@name='partner_id']" position="after">
                <field name="payment_mode" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_batch_payment_tree_inherit_aafa" model="ir.ui.view">
        <field name="name">account.batch.payment.list.inherit.aafa</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_tree"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="payment_mode" optional="show"/>
                <field name="memo" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
