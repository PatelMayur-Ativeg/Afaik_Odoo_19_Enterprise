<odoo>
    <record id="account_payment_form_inherit_bank_details" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.bank.details</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <group name="group2" position="inside">
                <field name="transaction_type"/>
                <field name="payment_mode"/>
                <field name="customer_transaction_ref"/>
                <field name="transaction_type_code"/>
                <field name="bank_to_bank"/>
                <field name="charge_type"/>
                <field name="regulatory_ttc_code"/>
            </group>
            <group name="group2" position="after">
                <group>
                    <field name="payment_detail_1"/>
                    <field name="payment_detail_2"/>
                    <field name="additional_details"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
