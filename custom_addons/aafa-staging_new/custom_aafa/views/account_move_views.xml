<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List header button: same as Action > Confirm Entries (account.action_validate_account_moves) -->
    <record id="view_move_tree_confirm_entries" model="ir.ui.view">
        <field name="name">account.move.list.confirm.entries</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_validate_moves_with_confirmation"
                            type="object"
                            string="Confirm Entries"
                            class="btn-primary"
                            groups="account.group_account_invoice"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Transaction Type on invoice/bill and journal entry Other Info -->
    <record id="view_move_form_transaction_type" model="ir.ui.view">
        <field name="name">account.move.form.transaction.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="inside">
                <field name="transaction_type"/>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//group[@name='misc_group']" position="inside">
                <field name="transaction_type"/>
            </xpath>
        </field>
    </record>
</odoo>
