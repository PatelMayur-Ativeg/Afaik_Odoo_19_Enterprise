<?xml version="1.0"?>
<odoo>
        <record id="vendor_reject_reason_view_form" model="ir.ui.view">
            <field name="name">vendor.reject.reason.form</field>
            <field name="model">reject.reason.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Reason">
                    <group>
                        <field name="reject_reason"/>
                    </group>
                    <footer>
                        <button name="action_reject_reason_apply" string="Submit" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="reject_reason_action" model="ir.actions.act_window">
            <field name="name">Reject Reason</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">reject.reason.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="vendor_reject_reason_view_form"/>
            <field name="target">new</field>
        </record>
</odoo>