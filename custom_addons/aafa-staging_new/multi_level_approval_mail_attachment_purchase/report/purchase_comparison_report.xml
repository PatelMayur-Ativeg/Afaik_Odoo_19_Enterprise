<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_purchase_rfq_comparison" model="report.paperformat">
        <field name="name">RFQ Comparison Sheet</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">48</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_purchase_rfq_comparison" model="ir.actions.report">
        <field name="name">RFQ Comparison Sheet</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">multi_level_approval_mail_attachment_purchase.report_purchase_rfq_comparison</field>
        <field name="report_file">multi_level_approval_mail_attachment_purchase.report_purchase_rfq_comparison</field>
        <field name="print_report_name">'RFQ Comparison - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_purchase_rfq_comparison"/>
    </record>
</odoo>
