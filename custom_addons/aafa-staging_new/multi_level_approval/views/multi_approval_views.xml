<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="multi_approval_line_view_form" model="ir.ui.view">
        <field name="name">multi.approval.line.form</field>
        <field name="model">multi.approval.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="user_id" readonly="1" />
                            <field
                                name="proxy_user_ids"
                                widget="many2many_avatar_user"
                                readonly="1"
                            />
                            <field name="require_opt" readonly="1" />
                        </group>
                        <group>
                            <field name="state" readonly="1" />
                            <field name="deadline" readonly="1" />
                            <field name="request_date" readonly="1" />
                            <field name="approved_date" readonly="1" />
                            <field
                                name="refused_reason"
                                readonly="1"
                                invisible="not refused_reason"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="multi_approval_view_tree" model="ir.ui.view">
        <field name="name">multi_approval_view_tree</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <list import="false">
                <field name="priority" widget="priority" />
                <field name="code" />
                <field name="name" />
                <field name="user_id" />
                <field name="request_date" />
                <field name="pic_id" />
                <field name="deadline" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="multi_approval_view_filter" model="ir.ui.view">
        <field name="name">multi_approval_view_filter</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <search string="Approvals">
                <field name="code" />
                <field name="name" />
                <field name="user_id" />
                <field name="pic_id" />
                <field name="proxy_pic_ids"/>
                <field name="type_id" />
                <filter
                    string="My Request"
                    name="my_request"
                    domain="[('user_id', '=', uid)]"
                />
                <separator />
                <filter
                    string="My Approvals"
                    name="my_approval"
                    domain="['|', ('pic_id', '=', uid), ('proxy_pic_ids', 'in', [uid])]"
                />
                <filter
                    string="To Review"
                    name="to_review"
                    domain="['&amp;', '|', ('pic_id', '=', uid), ('proxy_pic_ids', 'in', [uid]), ('state', '=', 'Submitted')]"
                />
                <group>
                    <filter
                        string="User"
                        name="groupby_user"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        string="Type"
                        name="groupby_type"
                        context="{'group_by': 'type_id'}"
                    />
                    <filter
                        string="Status"
                        name="groupby_status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Request Date"
                        name="groupby_date"
                        context="{'group_by': 'request_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="multi_approval_view_form" model="ir.ui.view">
        <field name="name">multi_approval_view_form</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name='is_pic' invisible="1" />
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        invisible="state != 'Draft'"
                        class="btn-primary"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        invisible="not is_pic or state != 'Submitted'"
                        class="btn-primary"
                    />
                    <button
                        name="%(multi_level_approval.refused_reason_action)d"
                        type="action"
                        invisible="not is_pic or state != 'Submitted'"
                        string="Refuse"
                    />
                    <widget
                        name="attach_document"
                        string="Attach Document"
                        action="message_post"
                        invisible="(document_opt == 'Required' and not attachment_number) or not id"
                    />
                    <widget
                        name="attach_document"
                        string="Attach Document"
                        action="message_post"
                        highlight="1"
                        invisible="document_opt != 'Required' or attachment_number or not id"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'Draft'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state == 'Draft'"
                        groups="base.group_erp_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="Draft,Submitted,Approved,Cancel"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1" />
                        </h1>

                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field
                                name="name"
                                placeholder="Title"
                                readonly="state != 'Draft'"
                            />
                        </h1>
                        <field
                            name="priority"
                            widget="priority"
                            readonly="state != 'Draft'"
                        />
                    </div>
                    <div
                        style="background: rgb(245, 245, 245);margin: 0px !important;padding: 10px;border: 1px solid rgb(207, 207, 207);"
                    >
                        <group>
                            <group>
                                <field name="user_id" readonly="1" />
                                <field
                                    name="request_date"
                                    readonly="state != 'Draft'"
                                />
                                <field
                                    name="type_id"
                                    readonly="state != 'Draft'"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                                <field name="deadline" readonly="1" />
                                <field name="pic_id" readonly="1" />
                            </group>
                            <group>
                                <field
                                    name="contact_id"
                                    readonly="state != 'Draft'"
                                    invisible="contact_opt in ('None', False)"
                                    required="contact_opt == 'Required'"
                                />
                                <field
                                    name="date"
                                    readonly="state != 'Draft'"
                                    invisible="date_opt in ('None', False)"
                                    required="date_opt == 'Required'"
                                />
                                <label
                                    for="date_start"
                                    string="Period"
                                    invisible="period_opt in ('None', False)"
                                />
                                <div invisible="period_opt in ('None', False)">
                                    <div>
                                    <span>From: </span><field
                                            name="date_start"
                                            class="oe_inline"
                                            readonly="state != 'Draft'"
                                            required="period_opt == 'Required'"
                                        />
                                    </div>
                                    <div>
                                    <span>to: </span><field
                                            name="date_end"
                                            class="oe_inline"
                                            readonly="state != 'Draft'"
                                            required="period_opt == 'Required'"
                                        />
                                    </div>
                                </div>
                                <field
                                    name="item_id"
                                    readonly="state != 'Draft'"
                                    invisible="item_opt in ('None', False)"
                                    required="item_opt == 'Required'"
                                />
                                <field
                                    name="quantity"
                                    readonly="state != 'Draft'"
                                    invisible="quantity_opt in ('None', False)"
                                    required="quantity_opt == 'Required'"
                                />
                                <field
                                    name="amount"
                                    readonly="state != 'Draft'"
                                    invisible="amount_opt in ('None', False)"
                                    required="amount_opt == 'Required'"
                                />
                                <field
                                    name="payment"
                                    readonly="state != 'Draft'"
                                    invisible="payment_opt in ('None', False)"
                                    required="payment_opt == 'Required'"
                                />
                                <field
                                    name="reference"
                                    readonly="state != 'Draft'"
                                    invisible="reference_opt in ('None', False)"
                                    required="reference_opt == 'Required'"
                                />
                                <field
                                    name="location"
                                    readonly="state != 'Draft'"
                                    invisible="location_opt in ('None', False)"
                                    required="location_opt == 'Required'"
                                />
                            </group>
                        </group>
                        <group
                            string="Items"
                            invisible="multi_items_opt in ('None', False)"
                        >
                            <field
                                name="item_ids"
                                nolabel="1"
                                colspan="2"
                                readonly="state != 'Draft'"
                                invisible="multi_items_opt in ('None', False)"
                                required="multi_items_opt == 'Required'"
                            />
                        </group>
                    </div>

                    <notebook>
                        <page string="Description" name="description">
                            <field
                                name="description"
                                nolabel="1"
                                placeholder='Description'
                                readonly="state != 'Draft'"
                            />
                        </page>
                        <page
                            string="Approver(s)"
                            name="approver"
                            invisible="state in ('Draft', 'Cancel')"
                        >
                            <field name="line_ids">
                                <list
                                    editable="top"
                                    create="false"
                                    delete="false"
                                    open_form_view="True"
                                >
                                    <field name="name" readonly="1" />
                                    <field
                                        name="request_date"
                                        string="Requested On"
                                        readonly="1"
                                        optional="show"
                                    />
                                    <field name="user_id" readonly="1" />
                                    <field name="proxy_user_ids" widget="many2many_avatar_user" readonly="1" />
                                    <field name="require_opt" readonly="1" />
                                    <field
                                        name="deadline"
                                        readonly="state not in ('draft', 'Waiting for Approval')"
                                    />
                                    <field
                                        name="approved_date"
                                        string="Approved On"
                                        readonly="1"
                                        optional="show"
                                    />
                                    <field
                                        name="last_reminder_date"
                                        string="Last Reminder On"
                                        readonly="1"
                                        optional="hide"
                                    />
                                    <field name="state" readonly="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Options" name="options" invisible="1">
                            <group string="Fields" name="option_settings">
                                <group>
                                    <field
                                        name="document_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="contact_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="date_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="period_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="item_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="multi_items_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="quantity_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="amount_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="payment_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="reference_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field
                                        name="location_opt"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                    <field name="attachment_number" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="multi_approval_view_kanban" model="ir.ui.view">
        <field name="name">multi_approval_view_kanban</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <kanban class="o_modules_kanban" import="false">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="image" widget="image" class="mt-2" />
                        </aside>
                        <main class="ms-4">
                            <field name="code" class="fw-bold fs-5" />
                            <p class="text-muted small my-0 lh-1">
                                <field name="priority" widget="priority" />
                            </p>
                            <p class="text-muted small my-0 lh-1">
                                <field name="name" />
                            </p>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
