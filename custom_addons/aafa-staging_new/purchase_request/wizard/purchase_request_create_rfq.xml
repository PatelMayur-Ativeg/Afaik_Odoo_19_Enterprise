<odoo>
    <data>
        <record id="purchase_request_create_rfq_form" model="ir.ui.view">
            <field name="name">Create RFQ</field>
            <field name="model">purchase.request.quotation</field>
            <field name="arch" type="xml">
                <form string="Create RFQ">
                    <group>
                        <field name="origin_pr_id" invisible="1"/>
                        <group>
                            <field name="partner_id"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <footer>
                        <button name="action_create_rfq" string="Create RFQ" data-hotkey="q" type="object" colspan="1" class="btn-primary"/>
                        <button string="Cancel"  data-hotkey="x" special="cancel" colspan="1" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
