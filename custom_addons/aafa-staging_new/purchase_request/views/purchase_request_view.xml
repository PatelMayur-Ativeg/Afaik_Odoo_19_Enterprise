<?xml version="1.0" ?>

<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button
                        name="button_draft"
                        string="Reset to Draft"
                        type="object"
                        groups="purchase_request.group_purchase_request_manager"
                        invisible="state not in ('waiting_for_approval', 'in_progress', 'reject', 'done')"
                    />
                    <field name="view_submit_button" invisible="1"/>
                    <button
                        name="submit_for_approval"
                        string="Submit for Approval"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft' or not view_submit_button"
                    />
                    <field name="show_rfq_btn" invisible="1"/>
                    <button name="create_rfq" groups="purchase_request.group_purchase_request_itadmin,purchase_request.group_purchase_request_gnadmin" string="Create RFQ" type="object" class="oe_highlight" invisible="state != 'waiting_for_approval' or not show_rfq_btn or purchase_count > 0"/>
                    <button name="create_rfq" groups="purchase_request.group_purchase_request_itadmin,purchase_request.group_purchase_request_gnadmin" string="Create RFQ" type="object" invisible="state != 'waiting_for_approval' or not show_rfq_btn or purchase_count &lt;= 0"/>

                    <button
                        name="button_approved"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        groups="purchase_request.group_purchase_request_manager"
                        invisible="state != 'waiting_for_approval'"
                    />
                    <button
                        name="button_done"
                        string="Done"
                        type="object"
                        class="oe_highlight"
                        groups="purchase_request.group_purchase_request_manager"
                        invisible="state != 'in_progress'"
                    />
                    <button
                        name="button_rejected"
                        string="Reject"
                        type="object"
                        groups="purchase_request.group_purchase_request_manager"
                        invisible="state != 'waiting_for_approval'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,waiting_for_approval,in_progress,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_purchase_order"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            string="Purchase Order"
                        >
                            <field
                                name="purchase_count"
                                widget="statinfo"
                                string="Purchase Orders"
                            />
                        </button>
                        <button
                            type="object"
                            name="action_view_stock_picking"
                            class="oe_stat_button"
                            groups="stock.group_stock_manager"
                            icon="fa-truck"
                            string="Picking"
                        >
                            <field
                                name="picking_count"
                                widget="statinfo"
                                string="Pickings"
                            />
                        </button>
                    </div>
                    <div class="oe_edit_only">
                        <label for="name" class="oe_inline" readonly="1" />
                    </div>
                    <h1>
                        <field name="is_editable" invisible="1" />
                        
                        <field
                            name="name"
                            class="oe_inline"
                            readonly="1"
                        />
                    </h1>
                    <group>
                        <group>
                            <field
                                name="employee_id"
                                readonly="not is_editable"
                            />
                            <field
                                name="assigned_manager_id" string="Requisition Responsible"
                                readonly="not is_editable"
                            />
                            <field name="department_id" readonly="not is_editable"/>
                            <field
                                name="description"
                                readonly="not is_editable"
                            />
                        </group>
                        <group>
                            <field
                                name="origin"
                                class="oe_inline"
                                readonly="not is_editable"
                            />
                            <field name="pr_category_id" required="1" readonly="not is_editable"/>
                            <field
                                name="date_start"
                                readonly="not is_editable"
                            />
                            <field
                                name="recieved_date"
                                readonly="not is_editable"
                            />
                            <field
                                name="requisition_deadline"
                                readonly="not is_editable"
                            />
                            
                            <!-- <field
                                name="group_id"
                                readonly="not is_editable"
                            /> -->
                            <field name="budget_id_domain" invisible="1"/>
                            <field name="show_budget_fields" invisible="1"/>
                            <field name="budget_id" domain="budget_id_domain" readonly="1" force_save="1"  invisible="not show_budget_fields"/>
                            <field name="budget_planned_amt" string="Planned Amt." invisible="not show_budget_fields"/>
                            <field name="practical_amt" string="Actual Amt." invisible="not show_budget_fields" decoration-danger="practical_amt &lt; 0"/>
                            <field name="check_budget_amt" invisible="1"/>
                            <field name="forecast_amt" string="PR Amount" invisible="not show_budget_fields" decoration-danger="forecast_amt &lt; 0"/>
                            <field name="forecast_remaining_amt" string="Remaining Budget"   style="color:red;"  invisible="not check_budget_amt or not show_budget_fields"/>
                            <field name="forecast_remaining_amt" string="Remaining Budget"   style="color:green;"  invisible="check_budget_amt or not show_budget_fields"/>
                            <!-- <field name="analytic_distribution" widget="analytic_distribution"/> -->
                            <field name="analytic_account_id" force_save="1"  readonly="not is_editable"
                            invisible="not show_budget_fields"/>
                            <field name="pr_type"/>
                            <!-- <field name="budget_type"/> -->
                            
                            
                        </group>
                        <!-- domain="[('department_id','=',department_id)]" -->
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                widget="selection"
                                readonly="not is_editable"
                            />
                            <field name="new_product_request"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" invisible="new_product_request">
                            <field name="line_ids" readonly="not is_editable">
                                <list
                                    decoration-muted="cancelled == True"
                                    editable="bottom"
                                >
                                    <field name="pr_category_id" invisible="1"/>
                                    <field name="requisition_action" string="Requisiton Action"/>
                                    <field name="product_id" options="{'no_open': True, 'no_create': True}" required="1" domain="[('categ_id.pr_category_id','=',pr_category_id)]"/>
                                    <field name="name" optional="hide"/>
                                    <!-- <field name="able_to_modify_costprice" invisible="1"/> -->
                                    <field name="cost_price" optional="hide" readonly="not able_to_modify_costprice"/>
                                    <field name="product_qty" required="1"/>
                                    <!-- <field name="qty_to_buy"/> -->
                                    <!-- <field name="pending_qty_to_receive"/> -->
                                    <!-- <field
                                        name="product_uom_category_id"
                                        invisible="1"
                                    /> -->
                                    
                                    <!-- <field name="analytic_account_id" groups="analytic.group_analytic_accounting" readonly="1" force_save="1"/> -->
                                    <field
                                        name="product_uom_id"
                                        invisible="1"
                                        groups="!uom.group_uom"
                                    />
                                    <field
                                        name="product_uom_id"
                                        groups="uom.group_uom"
                                        required="1"
                                    />
                                    <field name="free_qty_today" string="Avilable QTY"/>
                                    <!-- <field name="vendor_id" widget="many2many_tags"/>
                                    <field name="remarks" optional="hide"/>
                                    <field name="cancelled" invisible="1" />
                                    <field name="is_editable" invisible="1" />
                                    <field name="chosen_vendor_id" invisible="1" /> -->
                                    
                                </list>
                            </field>
                        </page>
                        <page string="New Products Request" invisible="not new_product_request">
                            <field name="new_line_ids" readonly="not is_editable">
                                <list
                                    decoration-muted="cancelled == True"
                                    editable="bottom"
                                >   
                                    <field name="desc" required="1"/>
                                    <field name="cost_price" />
                                    <field name="request_qty" required="1"/>
                                    <field name="cancelled" invisible="1" />
                                    <field name="is_editable" invisible="1" />
                                </list>
                            </field>
                        </page>
                        <!-- <page name="picking_info" string="Picking Details">
                            <group>
                            <group>
                            <field
                                name="picking_type_id" options="{'no_open': True, 'no_create': True}"
                                readonly="not is_editable"
                            />
                            <field
                                name="src_location_id" options="{'no_open': True, 'no_create': True}"
                                readonly="not is_editable"
                            />
                            <field
                                name="dest_location_id" options="{'no_open': True, 'no_create': True}"
                                readonly="not is_editable"
                            />
                            </group>
                            </group>
                        </page> -->
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
 

    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list
                decoration-bf="message_needaction==True"
                decoration-info="state in ('draft','waiting_for_approval')"
                decoration-muted="state in ('reject')"
                name="Purchase Request"
            >
                <field name="message_needaction" invisible="1" />
                <field name="name" />
                <field name="date_start" />
                <field name="requested_by" widget="many2one_avatar_user" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    widget="selection"
                />
                <field name="activity_ids" widget="list_activity" optional="show" />
                <field name="origin" />
                <field name="currency_id" invisible="1" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state in ('done', 'in_progress')"
                    decoration-muted="state == 'draft'"
                    decoration-warning="state == 'waiting_for_approval'"
                    decoration-danger="state == 'reject'"
                />
            </list>
        </field>
    </record>
    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Request">
                <field name="name" string="Purchase Request"
                    filter_domain="['|', ('name', 'ilike', self), ('origin', 'ilike', self)]"/>
                <field name="requested_by"/>
                <field name="assigned_to"/>
                <field name="employee_id"/>
                <field name="picking_type_id"/>
                <field name="origin"/>
                <separator/>
                <filter name="unassigned" string="Unassigned"
                    domain="[('assigned_to', '=', False)]"/>
                <filter name="my_requests" string="My Requests"
                    domain="[('requested_by', '=', uid)]"/>
                <filter name="assigned_to_me" string="Assigned to Me"
                    domain="[('assigned_to', '=', uid)]"/>
                <separator/>
                <filter name="state_draft" string="Draft"
                    domain="[('state', '=', 'draft')]"/>
                <filter name="state_waiting_for_approval" string="Waiting for Approval"
                    domain="[('state', '=', 'waiting_for_approval')]"/>
                <filter name="state_in_progress" string="In Progress"
                    domain="[('state', '=', 'in_progress')]"/>
                <filter name="state_rejected" string="Rejected"
                    domain="[('state', '=', 'reject')]"/>
                <filter name="state_done" string="Done"
                    domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="message_needaction" string="Unread Messages"
                    domain="[('message_needaction', '=', True)]"/>
                <group>
                    <filter name="group_requested_by" string="Requested By"
                        domain="[]" context="{'group_by': 'requested_by'}"/>
                    <filter name="group_assigned_to" string="Assigned To"
                        domain="[]" context="{'group_by': 'assigned_to'}"/>
                    <filter name="group_source" string="Source"
                        domain="[]" context="{'group_by': 'origin'}"/>
                    <filter name="group_start_date" string="Start Date"
                        domain="[]" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- "search_default_requested_by":uid -->
    <record model="ir.actions.act_window" id="purchase_request_form_action">
        <field name="name">Purchase Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="view_purchase_request_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to start a new purchase request process.
            </p>
            <p>
            </p>
        </field>
    </record>
    <menuitem
        id="menu_purchase_request_pro_mgt"
        parent="purchase.menu_procurement_management"
        action="purchase_request_form_action"
    />
    <menuitem
        id="parent_menu_purchase_request"
        name="Purchase Requests"
        sequence="22"
        web_icon="purchase_request,static/description/icon.png"
        groups="group_purchase_request_user,group_purchase_request_manager"
    />
    <menuitem
        id="menu_purchase_request"
        name="Purchase Requests"
        parent="parent_menu_purchase_request"
        groups="group_purchase_request_user,group_purchase_request_manager"
    />
    <menuitem
        id="menu_purchase_request_act"
        sequence="10"
        parent="menu_purchase_request"
        action="purchase_request_form_action"
    />
</odoo>
