<guru>
    <template id="purchase_request_external_layout_standard">
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row">
                <div class="col-9 mb4">
                    Expense Purchase Request Form
                </div>
               <div class="col-3 mb4">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 160px;margin-top: 50px;" alt="Logo"/>
                </div>
            </div>

        </div>

        <div t-attf-class="article o_report_layout_standard o_company_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div>
                <!-- This div ensures that the address is not cropped by the header. -->
                <t t-call="web.address_layout"/>
            </div>
            <t t-raw="0"/>
        </div>
        <div t-attf-class="footer o_standard_footer o_company_layout">
        </div>

    </template>


    <template id="web.external_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <style type="text/css">
            .container {
            width:600px;
            height:190px;
            <!-- background-color:green; -->
            padding-top:20px;
            padding-left:15px;
            padding-right:15px;
            }
            #st-box {
            float:left;
            width:180px;
            height:160px;
            background-color:white;
            border:solid black;
            }
            #nd-box {
            float:left;
            width:180px;
            height:160px;
            background-color:white;
            border:solid black;
            margin-left:20px;
            }
            #rd-box {
            float:right;
            width:180px;
            height:160px;
            background-color:white;
            border:solid black;
            }
            h1 {
            color:Green;
            }
        </style>
        <t t-if="o">
            <t t-if="o._name in ['purchase.request']">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                    <t t-call="purchase_request.purchase_request_external_layout_standard">
                        <t t-raw="0"/>
                    </t>
            </t>
            <t t-else="">
                    <t t-if="not company">

                        <t t-if="company_id">
                            <t t-set="company" t-value="company_id"/>
                        </t>
                        <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                            <t t-set="company" t-value="o.company_id.sudo()"/>
                        </t>
                        <t t-else="else">
                            <t t-set="company" t-value="res_company"/>
                        </t>
                    </t>
                    <t t-if="company.external_report_layout_id" t-call="{{company.external_report_layout_id.key}}">
                        <t t-raw="0"/>
                    </t>

                    <t t-else="else" t-call="web.external_layout_standard">
                        <t t-raw="0"/>
                    </t>

                </t> 
        </t>
        <t t-else="">
            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <t t-if="company.external_report_layout_id" t-call="{{company.external_report_layout_id.sudo().key}}"><t t-raw="0"/></t>
            <t t-else="else" t-call="web.external_layout_standard"><t t-raw="0"/></t>

        </t>
    </template>

</guru>
