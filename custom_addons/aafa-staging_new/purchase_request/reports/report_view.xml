<guru>
	<data>
		<template id="report_purchase_request_document">
			<t t-call="web.external_layout">
				<t t-set="o" t-value="o.with_context(lang=lang)"/>
				<div class="page">
					<div class="row col-12" id="informations" style="border-bottom: 1px dotted #808080; border-top: 1px dotted #808080;">
						<div class="col-6" style="border-right: 1px dotted #808080;font-size: 11px; color: #2E404A;">
							<t t-if="o.date_start">
								<strong>
									<span style="font-size:14px;">Date of Request: </span><span style="font-size:14px;" t-esc="o.date_start"></span>
								</strong>
								<br/>
							</t>
							<t t-if="o.employee_id">
								<strong>
									<span style="font-size:14px;">Name: </span><span style="font-size:14px;" t-esc="o.employee_id.name"></span>
								</strong>
								<br/>
							</t>

						</div>
						<div class="col-6" style="border-right: 1px dotted #808080;font-size: 11px; color: #2E404A;">
							<t t-if="o.name">
								<strong>
									<span style="font-size:14px;">Ref Number: </span><span style="font-size:14px;" t-esc="o.name"></span>
								</strong>
								<br/>
							</t>
							<t t-if="o.name">
								<strong>
									<span style="font-size:14px;">Department: </span><span style="font-size:14px;"></span>
								</strong>
								<br/>
							</t>
						</div>
					</div>
					<div class="row col-12" id="informations" style="border-bottom: 1px dotted #808080; border-top: 1px dotted #808080;">
						<div class="col-12" style="border-right: 1px dotted #808080;font-size: 11px; color: #2E404A;">
							<t t-if="o.name">
								<strong>
									<span style="font-size:14px;">Purpose: </span><span style="font-size:14px;" ></span>
								</strong>
								<br/>
							</t>
						</div>
					</div>
					<div class="row col-12" id="informations" style="border-bottom: 1px dotted #808080; border-top: 1px dotted #808080;">
						<div class="col-9" style="border-right: 1px dotted #808080;font-size: 11px; color: #2E404A;">
							<strong>
									<span style="font-size:14px;">Budgeted? </span><span style="font-size:14px;" ></span>
							</strong>
							<strong>
									<span style="font-size:14px;">Recurring </span><span style="font-size:14px;" ></span>
							</strong>
							<strong>
									<span style="font-size:14px;">New </span><span style="font-size:14px;" ></span>
							</strong>
							<br/>
						</div>
					</div>
					<table class="table table-sm o_main_table mt64" name="purchase_request_line_table" style="margin-top:64px;">
						<thead style="border: 1px solid black; display: table-row-group; ">
							<tr>
								<th name="th_description" class="text-center" style="border: 1px solid black; padding:5px;" colspan="2">Details of Goods or Services</th>
								<th name="th_priceunit" class="text-center" style="border: 1px solid black; padding:5px;">Estimated<br/>
								Cost (AED)</th>
								<th name="th_quantity" class="text-center" style="border: 1px solid black; padding:5px;">QTY</th>
								<th name="th_remarks" class="text-center" style="border: 1px solid black; padding:5px;">Remarks</th>
							</tr>
						</thead>
						<tbody class="purchase_request_tbody" style="font-size:14px;">
							<t t-foreach="o.line_ids" t-as="line">
									<tr>
											<td name="td_name" style="border: 1px solid black; padding:5px;" class="text-center" colspan="2">
												<span t-field="line.name"/>
											</td>
											<td class="text-center" style="border: 1px solid black; padding:5px;">
												<span t-esc="float(line.product_id.lst_price)"/>
											</td>
											<td class="text-center" style="border: 1px solid black; padding:5px;">
												<span t-esc="line.product_qty"/>
											</td>
											<td style="border: 1px solid black; padding:5px;" class="text-center">
												<span class="text-nowrap"/>
											</td>
									</tr>
							</t>
						</tbody>
					</table>
					<div class="clearfix">
						<style>
                        table, th, td {
                        border: 1px solid black;
                        border-collapse: collapse;
                        }
                    </style>
					</div>
				</div>
			</t>
		</template>
		
