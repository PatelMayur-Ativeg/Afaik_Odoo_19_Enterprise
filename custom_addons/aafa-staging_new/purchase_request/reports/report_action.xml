    <data>

        <record id="paperformat_base_sale" model="report.paperformat">
            <field name="name">Paper Format Purchase Request</field>
            <field name="default" eval="False"/>
            <field name="format">B4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">55</field>
            <field name="margin_bottom">45</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">58</field>
        </record>

        <record id="Purchase_request_report" model="ir.actions.report">
            <field name="name">Purhcase Request Report</field>
            <field name="model">purchase.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">purchase_request.report_purchase_request_document</field>
            <field name="report_file">purchase_request.report_purchase_request_document</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="attachment">((object.name).replace('/','_')+'.pdf')
            </field>
            <field name="binding_model_id" eval="purchase_request.model_purchase_request"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="invoice_report.paperformat_base_sale"/>
        </record>


