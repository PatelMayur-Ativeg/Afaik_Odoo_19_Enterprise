<odoo>
    <template id="report_canvas_sheet_report_form_document">
        <!-- <t t-call="web.external_layout"> -->
            <t t-set="o" t-value="o.with_context(lang=o.message_partner_ids.lang)"/>
            <div class="page">
                <div class="oe_structure"/>
                <!-- <strong><center><h1>
                    Canvas Sheet
                </h1></center></strong> -->
                <div style="width:80%;float: left;">
                    <strong><left><h1>
                        <p style="font-size:40px;color:#00008B;padding-top:14mm; padding-left:5mm;">Canvas Sheet</p>
                    </h1></left></strong>
                </div>
                <div style="width:20%;float: right;">
                    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height:180px; width:100%; padding-top:0mm; padding-right:5mm; padding-left:0mm;" />
                </div> 
                <br/>
                <br/>
                <table class="information" width="100%" style="border: 0px solid black;">
                    <tr>
                        <td width="30%" style="border: 0px solid black;text-align:left;">
                            <strong>Office Supply Request Ref. No.:</strong>
                        </td>
                        <td width="25%" style="border-bottom: 1px solid black;text-align:left;">
                            <div t-field="o.name"/>                           
                        </td>
                        <td width="10%" style="text-align:center;border: 0px solid black;">
                            <strong>Date:</strong><br/>
                        </td>
                        <td width="30%" style="border-bottom: 1px solid black;">
                            <div t-field="o.date_start"/>
                        </td>
                    </tr>
                </table>
                <br/> <br/>
                <table class="purchase_table_lines" width="100%" style="border:1px solid black; border-collapse: collapse;">
                    <thead>
                        <tr style="border:1px solid black">
                            <th style="border:1px solid black; font-weight:bold; text-align:center; background-color:#D3D3D3;" width="25%" >Details of Goods or Services</th>
                            <th colspan="3" style="border:1px solid black; font-weight:bold; text-align:center;  background-color:#D3D3D3;" width="60%">Supplier Name</th>
                            <th style="border:1px solid black; font-weight:bold; text-align:center; background-color:#D3D3D3;" width="15%">Chosen Supplier</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.line_ids" t-as="line">
                            <tr style="border:1px solid black">
                                <td width="25%" style="border:1px solid black; padding-left:2mm;">
                                    <span t-field="line.product_id.name"/>
                                </td>
                                
                                <t t-set="i" t-value="1"/>
                                <t t-foreach="line.product_id.seller_ids" t-as="rec">
                                    <!-- <t t-if ="line.vendor_id">  -->
                                        <t t-if ="i &lt; 4"> 
                                            <td style="border:1px solid black; padding-left:2mm;" width="20%" >
                                                <span t-field="rec.partner_id.name"/>
                                            </td>
                                        </t>
                                        <t t-set="i" t-value="i+1"/>
                                    <!-- </t> -->
                                </t>
                                <t t-if ="i-1 == 0"> 
                                    <td style="border:1px solid black;" width="20%" ></td>
                                    <td style="border:1px solid black;" width="20%"></td>
                                    <td style="border:1px solid black;" width="20%"></td>
                                </t>
                                <t t-if ="i-1 == 1"> 
                                    <td style="border:1px solid black;" width="20%"></td>
                                    <td style="border:1px solid black;" width="20%"></td>
                                </t>
                                <t t-if ="i-1 == 2">
                                    <td style="border:1px solid black;" width="20%"></td>
                                </t> 

                                <!-- </t>   -->
                                <!-- <t t-if ="not line.vendor_id"> 
                                    <td style="border:1px solid black;"></td>
                                    <td style="border:1px solid black;"></td>
                                    <td style="border:1px solid black;"></td>
                                </t> --> 
                                <td style="border:1px solid black; padding-left:2mm;" width="15%">
                                    <span t-field="line.chosen_vendor_id.name"/>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td colspan="5" style="border:1px solid black; padding-bottom:20mm;">Justification:</td>
                        </tr>
                    </tbody>
                </table>
                <br/> <br/> <br/>
               
                <div class="row">
                    <table class="signature_details" width="100%">
                        <tr>
                            <td style="page-break-inside: avoid; text-align:left;padding-bottom:8mm;">
                                <strong><i>Prepared By:</i></strong>
                            </td>
                            <td></td><td></td><td></td>
                            <td style="page-break-inside: avoid; text-align:center;padding-bottom:8mm;">
                                <strong><i>Reviewed By:</i></strong>
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td style="text-align:center;padding-bottom:8mm;">
                                <strong>Procurement Officer</strong>
                            </td>
                            <td></td><td></td><td></td>
                            <td style="text-align:right;">
                                <strong>Administration Manager</strong>
                            </td>
                            <td></td>
                        </tr>
                    </table>
                </div>  
                <div class="row">
                    <table class="signature_details2" width="100%">
                        <tr>
                            <td style="page-break-inside: avoid; text-align:left;padding-bottom:8mm; padding-top:10mm;">
                                <strong><i>Approved By:</i></strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid black; text-align:right; padding-top:5mm;" width="20%" >
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:left;padding-top:4mm;">
                                <strong>Name:</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:left;padding-top:4mm;">
                                <strong>Designation:</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:left;padding-top:4mm;">
                                <strong>Department:</strong>
                            </td>
                            <td style="text-align:right;"> </td>
                            <td style="text-align:right;"> </td>
                            <td></td>

                            <t t-if ="o.show_budget_fields"> 
                                <td style="text-align:right;"> <input type="checkbox" checked="checked"/></td>
                            </t>
                            <t t-if ="not o.show_budget_fields"> 
                                <td style="text-align:right;"> <input type="checkbox" /></td>
                            </t>
                            <td><strong>Budgeted</strong></td>

                            <t t-if ="o.show_budget_fields"> 
                                <td style="text-align:right;"> <input type="checkbox" /></td>
                            </t>
                            <t t-if ="not o.show_budget_fields"> 
                                <td style="text-align:right;"> <input type="checkbox" checked="checked"/></td>
                            </t>
                            <td><strong>Unbudgeted</strong></td>
                            <!-- <td style="text-align:right;"><strong>Unbudgeted</strong></td> -->
                        </tr>
                        <tr>
                            <td style="text-align:left;padding-top:4mm;">
                                <strong>Date:</strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        <!-- </t> -->
    </template>

    <template id="template_canvas_sheet_report_form">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="purchase_request.report_canvas_sheet_report_form_document" t-lang="o.message_partner_ids.lang"/>
            </t>
        </t>
    </template>
</odoo>