            <table class="purchase_table_lines" width="100%" style="border:1px solid black; border-collapse: collapse;">
                <thead>
                    <tr style="border:1px solid black">
                        <th style="border:1px solid black;font-weight:bold;background-color:#D3D3D3;" width="50%">
                            Details of Goods or Services
                        </th>
                        <th style="border:1px solid black;font-weight:bold;background-color:#D3D3D3;" width="15%">
                            Estimated Cost (AED)
                        </th>
                        <th style="border:1px solid black;font-weight:bold;background-color:#D3D3D3;" width="10%">QTY
                        </th>
                        <th style="border:1px solid black;font-weight:bold;background-color:#D3D3D3;" width="25%">
                            Remarks
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.line_ids" t-as="line">
                        <tr style="border:1px solid black">
                            <td style="border:1px solid black;padding-left:2mm;">
                                <t t-if="not o.new_product_request">
                                    <span t-field="line.product_id.name"/>
                                </t>
                            </td>
                            <td style="border:1px solid black;text-align:right">
                                <t t-if="not o.new_product_request">
                                    <span t-field="line.cost_price"/>
                                </t>
                            </td>
                            <td style="border:1px solid black;text-align:right">
                                <span t-field="line.product_qty"/>
                            </td>
                            <td style="border:1px solid black;text-align:left; padding-right:2mm;">
                                <span t-field="line.remarks"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <br/>
            <br/>

            <div class="row">
                <table class="signature_details" width="100%">
                    <tr>
                        <td style="page-break-inside: avoid; text-align:left;padding-bottom:4mm;">
                            <strong>Requested By:</strong>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td style="page-break-inside: avoid; text-align:left;padding-bottom:4mm;">
                            <strong>Reviewed By:</strong>
                        </td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid black; text-align:left; padding-top:5mm; padding-bottom:2mm;"
