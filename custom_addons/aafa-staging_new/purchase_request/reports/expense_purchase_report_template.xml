                                <t t-if="each.label_type == 'verified_by' ">
                                    <strong>Reviewed Control</strong>
                                </t>
                            </t>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td style="text-align:center;padding-bottom:4mm;">
                            <t t-foreach="approval_lines" t-as="each">
                                <t t-if="each.label_type == 'supported_by' ">
                                    <strong>Head of Finance and Treasury</strong>
                                </t>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="border-bottom: 1px solid black;padding-bottom:4mm;"></td>
                    </tr>
                    <!-- //=====================================// -->
                    <tr>
                        <td style="page-break-inside: avoid; text-align:left; padding-top:8mm; padding-bottom:4mm;">
                            <t t-foreach="approval_lines" t-as="each">
                                <t t-if="each.label_type == 'reviewed_by' and each.show_in_report">
                                    <strong>Reviewed By:</strong>
                                </t>
                            </t>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td style="page-break-inside: avoid; text-align:left; padding-bottom:4mm; padding-top:8mm;">
                            <t t-foreach="approval_lines" t-as="each">
                                <t t-if="each.label_type == 'approved_by' ">
                                    <strong>Approved By:</strong>
                                </t>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <t t-foreach="approval_lines" t-as="each">
                            <t t-if="each.label_type == 'reviewed_by' and each.show_in_report">
                                <td style="border-bottom: 1px solid black; text-align:left; padding-top:5mm; padding-bottom:2mm;"
