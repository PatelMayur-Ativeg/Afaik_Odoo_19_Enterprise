                        </td>
                    </tr>
                    <tr>
                        <td style="text-align:center;padding-bottom:4mm;">
                            <strong>Requesting Staff</strong>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td style="text-align:center;padding-bottom:4mm;">
                            <strong>Department Head/ Manager</strong>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="border-bottom: 1px solid black;padding-bottom:4mm;"></td>
                    </tr>
                    <!-- //=====================================// -->
                    <tr>
                        <td style="page-break-inside: avoid; text-align:left; padding-bottom:4mm; padding-top:8mm;">
                            <t t-foreach="approval_lines" t-as="each">
                                <t t-if="each.label_type == 'verified_by' ">
                                    <strong>Verified By:</strong>
                                </t>
                            </t>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td style="page-break-inside: avoid; text-align:left; padding-bottom:4mm; padding-top:8mm;">
                            <t t-foreach="approval_lines" t-as="each">
