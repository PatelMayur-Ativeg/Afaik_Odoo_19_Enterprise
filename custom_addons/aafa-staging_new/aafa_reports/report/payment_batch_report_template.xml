<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_batch_approval_document">
        <t t-call="web.external_layout">
        <t t-set="labels" t-value="o._get_batch_report_labels()"/>
        <div class="page o_payment_batch_report">
            <style>
                .o_payment_batch_report {
                    font-family: Helvetica, Arial, sans-serif;
                    font-size: 12px;
                    color: #000;
                }
                .o_payment_batch_report h1 {
                    text-align: left;
                    font-size: 18px;
                    margin: 0 0 2px 0;
                    text-transform: uppercase;
                }
                .o_payment_batch_report .page-subtitle {
                    font-size: 12px;
                    font-weight: bold;
                    text-transform: uppercase;
                    margin: 0 0 12px 0;
                }
                .o_payment_batch_report h2 {
                    font-size: 13px;
                    margin: 14px 0 8px 0;
                }
                .o_payment_batch_report table {
                    width: 100%;
                    border-collapse: collapse;
                }
                .o_payment_batch_report .info-table {
                    width: 58%;
                }
                .o_payment_batch_report th,
                .o_payment_batch_report td {
                    border: 1px solid #000;
                    padding: 6px 8px;
                    vertical-align: top;
                }
                .o_payment_batch_report th {
                    background: #ffffff;
                    font-weight: bold;
                    text-align: center;
                }
                .o_payment_batch_report .field-col {
                    width: 38%;
                    font-weight: bold;
                    text-align: left;
                }
                .o_payment_batch_report .text-right {
                    text-align: right;
                }
                .o_payment_batch_report .text-center {
                    text-align: center;
                }
                .o_payment_batch_report .text-left {
                    text-align: left;
                }
                .o_payment_batch_report .total-row td {
                    font-weight: bold;
                }
                .o_payment_batch_report .partner-title {
                    font-size: 13px;
                    font-weight: bold;
                    text-transform: uppercase;
                    margin: 0 0 8px 0;
                }
            </style>

            <h1>Payment Approval Batch</h1>
            <div class="page-subtitle">Page 1: Payment Batch Summary</div>
            <h2>Payment Approval Batch</h2>
            <table class="info-table o_ignore_layout_styling">
                <thead>
                    <tr>
                        <th class="field-col">Field</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="field-col">Batch Reference</td>
                        <td><span t-field="o.name"/></td>
                    </tr>
                    <tr>
                        <td class="field-col">Payment Date</td>
                        <td><span t-field="o.date" t-options="{'widget': 'date'}"/></td>
                    </tr>
                    <tr>
                        <td class="field-col"><span t-out="labels['partner_count']"/></td>
                        <td><span t-field="o.partner_count"/></td>
                    </tr>
                    <tr>
                        <td class="field-col">Total Payments</td>
                        <td>
                            <span t-field="o.currency_id.name"/>
                            <span t-out="o._get_batch_report_amount()" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="field-col">Payment Mode</td>
                        <td><span t-field="o.payment_mode"/></td>
                    </tr>
                    <tr>
                        <td class="field-col">Prepared By</td>
                        <td><span t-field="o.create_uid.name"/></td>
                    </tr>
                    <tr>
                        <td class="field-col">Prepared Date</td>
                        <td><span t-field="o.create_date" t-options="{'widget': 'date'}"/></td>
                    </tr>
                    <tr>
                        <td class="field-col">Memo / Remarks</td>
                        <td><span t-field="o.memo"/></td>
                    </tr>
                </tbody>
            </table>

            <h2>Payment Summary</h2>
            <table class="o_ignore_layout_styling">
                <thead>
                    <tr>
                        <th class="text-center" width="6%">#</th>
                        <th class="text-left"><span t-out="labels['partner_name']"/></th>
                        <th width="16%">Payment Date</th>
                        <th class="text-right" width="16%">Amount (<span t-field="o.currency_id.name"/>)</th>
                        <th width="16%">Mode of Payment</th>
                        <th class="text-left">Memo / Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.payment_ids" t-as="payment">
                        <tr>
                            <td class="text-center"><span t-out="payment_index + 1"/></td>
                            <td><span t-field="payment.partner_id.name"/></td>
                            <td class="text-center"><span t-field="payment.date" t-options="{'widget': 'date'}"/></td>
                            <td class="text-right">
                                <span t-out="o._convert_payment_amount(payment)" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td>
                                <span t-if="payment.payment_mode" t-field="payment.payment_mode"/>
                                <span t-else="" t-field="o.payment_mode"/>
                            </td>
                            <td><span t-out="payment._get_batch_report_memo()"/></td>
                        </tr>
                    </t>
                    <tr class="total-row">
                        <td/>
                        <td>TOTAL</td>
                        <td/>
                        <td class="text-right">
                            <span t-out="o._get_batch_report_amount()" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                        <td/>
                        <td/>
                    </tr>
                </tbody>
            </table>

            <t t-foreach="o.payment_ids" t-as="payment">
                <t t-set="pay_labels" t-value="payment._get_payment_report_labels()"/>
                <t t-set="bank_details" t-value="payment._get_batch_report_bank_details()"/>
                <t t-set="bill_data" t-value="payment._get_batch_report_bill_data()"/>
                <t t-set="bill_lines" t-value="bill_data['lines']"/>
                <t t-set="bill_paid" t-value="bill_data['paid']"/>
                <div style="page-break-before: always;">
                    <h1>Payment Approval Batch</h1>
                    <div class="page-subtitle">Page 2 Onwards: Payment Details</div>
                    <div class="partner-title"><span t-field="payment.partner_id.name"/></div>
                    <h2><span t-out="pay_labels['partner_info']"/></h2>
                    <table class="info-table o_ignore_layout_styling">
                        <thead>
                            <tr>
                                <th class="field-col">Field</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="field-col"><span t-out="pay_labels['partner_name']"/></td>
                                <td><span t-field="payment.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="field-col">Beneficiary Name</td>
                                <td><span t-out="bank_details['beneficiary_name']"/></td>
                            </tr>
                            <tr>
                                <td class="field-col">Account / IBAN</td>
                                <td><span t-out="bank_details['iban']"/></td>
                            </tr>
                            <tr>
                                <td class="field-col">Currency</td>
                                <td><span t-out="bank_details['currency']"/></td>
                            </tr>
                            <tr>
                                <td class="field-col">Payment Amount</td>
                                <td>
                                    <span t-field="payment.currency_id.name"/>
                                    <span t-out="abs(payment.amount or 0.0)" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="field-col">Payment Date</td>
                                <td><span t-field="payment.date" t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr>
                                <td class="field-col">Mode of Payment</td>
                                <td>
                                    <span t-if="payment.payment_mode" t-field="payment.payment_mode"/>
                                    <span t-else="" t-field="o.payment_mode"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="field-col">Payment Reference</td>
                                <td><span t-field="payment.name"/></td>
                            </tr>
                            <tr>
                                <td class="field-col">Memo / Remarks</td>
                                <td><span t-out="payment._get_batch_report_memo()"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h2><span t-out="pay_labels['doc_section']"/></h2>
                    <table class="o_ignore_layout_styling">
                        <thead>
                            <tr>
                                <th class="text-center" width="6%">#</th>
                                <th class="text-left"><span t-out="pay_labels['doc_no']"/></th>
                                <th width="16%"><span t-out="pay_labels['doc_date']"/></th>
                                <th class="text-right" width="22%"><span t-out="pay_labels['doc_amount']"/> (<span t-field="payment.currency_id.name"/>)</th>
                                <th class="text-left"><span t-out="pay_labels['doc_description']"/></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="bill_lines" t-as="bill">
                                <tr>
                                    <td class="text-center"><span t-out="bill['index']"/></td>
                                    <td><span t-out="bill['bill_no']"/></td>
                                    <td class="text-center">
                                        <span t-out="bill['bill_date']" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-out="bill['paid']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td><span t-out="bill['description']"/></td>
                                </tr>
                            </t>
                            <tr t-if="not bill_lines">
                                <td colspan="5" class="text-center"><span t-out="pay_labels['empty_docs']"/></td>
                            </tr>
                            <tr class="total-row" t-if="bill_lines">
                                <td/>
                                <td>TOTAL</td>
                                <td/>
                                <td class="text-right">
                                    <span t-out="bill_paid" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
        </t>
    </template>

    <template id="report_payment_batch_approval">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="aafa_reports.report_payment_batch_approval_document"/>
            </t>
        </t>
    </template>
</odoo>
